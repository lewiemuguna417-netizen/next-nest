# PAXFORM Backend Environment Configuration (Development)

# Application Configuration
NODE_ENV=development
APP_NAME=PAXFORM
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8080

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Frontend Configuration (Development)
NEXT_PUBLIC_API_URL=http://localhost:8080
VITE_BACKEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api/v1

# CORS Configuration (Development)
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS

# Security Configuration (Development)
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE=86400000
HELMET_ENABLED=false
HELMET_CSP_ENABLED=false
HELMET_HSTS_ENABLED=false

# Database Configuration (Local PostgreSQL for Development)
# For local development, you can use either:
# 1. Local PostgreSQL: DATABASE_URL=postgresql://postgres:password@localhost:5432/paxform_dev
# 2. Docker PostgreSQL: DATABASE_URL=postgresql://postgres:password@localhost:5433/paxform_dev
# 3. Keep production DB but with shorter timeouts: DATABASE_URL=postgresql://neondb_owner:npg_WAw94UlzxQJY@ep-late-butterfly-a4of6k3z-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# For now, let's use the production DB but with optimized settings for development
DATABASE_URL=postgresql://neondb_owner:npg_WAw94UlzxQJY@ep-late-butterfly-a4of6k3z-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
